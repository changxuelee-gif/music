# ============ 服务基础 ============
NODE_ENV=production
PORT=3000
# 前端构建产物目录（Express 托管静态资源）
WEB_DIST=../web/dist
# 允许跨域的来源（多个用英文逗号分隔），同域部署可留空
CORS_ORIGIN=http://localhost:5173
# 站点正式域名，用于生成 sitemap、robots、og:url（不要带结尾斜杠）
SITE_URL=https://music.tengxiangtech.com

# ============ MySQL ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fh_music
MYSQL_PASSWORD=fh_music_123
MYSQL_DATABASE=fenghuang_music
MYSQL_CONNECTION_LIMIT=10

# ============ Redis（首页/分类缓存，不可用时自动降级为直查数据库）============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis123456
REDIS_DB=0
CACHE_TTL_HOME=180
CACHE_TTL_LIST=120

# ============ JWT ============
JWT_SECRET=请替换为至少32位的随机字符串
JWT_EXPIRES=2h
JWT_USER_EXPIRES=7d

# ============ 阿里云 OSS（未配置时自动降级为本地 uploads 目录存储）============
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 自定义域名，例如 https://cdn.example.com ；留空则使用 OSS 默认域名
OSS_PUBLIC_HOST=
# 上传大小上限（MB）
UPLOAD_MAX_MB=5

# ============ 外链白名单（合规红线，只允许这些正版音乐平台域名）============
# 支持主域名匹配其所有子域名，多个用英文逗号分隔
ALLOWED_MUSIC_DOMAINS=y.qq.com,qqmusic.qq.com,music.163.com,kugou.com,kuwo.cn,qishui.douyin.com,music.douyin.com,migu.cn

# 初始管理员（仅 scripts/init-db.js 首次执行时使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
